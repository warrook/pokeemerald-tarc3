mapscripts Beach_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TAMAGOTCHI_STAGE_EXPLAINED, 0: Tamagotchi_BabyEvo_Explanation
        VAR_TAMAGOTCHI_STAGE_EXPLAINED, 1: Tamagotchi_KidEvo_Explanation
        VAR_TAMAGOTCHI_STAGE_EXPLAINED, 2: Tamagotchi_YoungEvo_Explanation
    ]
}

script Beach_Palooka_A {
    trainerbattle_single(TRAINER_BEACH_A, format("Bleh!"), format("Bleh..."), Beach_Palooka_A_Defeated)
}

script Beach_Palooka_A_Defeated {
    special(PlayerFaceTrainerAfterBattle)
	waitmovement
    msgbox(format("Yikes! You're strong!"))
    closemessage
    call(Tamagotchi_Palookaport_Out)
}

script Beach_Palooka_B {
    trainerbattle_single(TRAINER_BEACH_B, format("Bleh!"), format("Bleh..."), Tamagotchi_Palookaport_Out)
}

