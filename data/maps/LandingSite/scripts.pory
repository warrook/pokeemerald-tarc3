mapscripts LandingSite_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        setrespawn(HEAL_LOCATION_LANDING_SITE)
        end
    }
}

script Banzo_EventScript_Intro
{
    lockall
    playse(SE_POKENAV_CALL)
    delay(60)
    playse(SE_POKENAV_ON)
    suitcall("Prof. Banzo: {PLAYER}?\h15 {PLAYER}??\h30
              I just saw you land, can you hear me?!")
    waitmessage
    playse(SE_POKENAV_OFF)
    waitse
    // Exit the lander
    playse(SE_POKENAV_ON)
    suitcall("Ahem.\h30 Okay, good, you're alive. Excellent.
              And you know how to respond to comms.
              
              Odd how this planet is so like ours, huh?
              
              Your first task is to find an Exo-Pok\emon
              to protect you.
              
              The ones nearby should be docile enough
              for you to catch by yourself. Just don't
              go very far, it's too dangerous and we
              didn't bring a spare astronaut.")
    waitmessage
    applymovement(LOCALID_PLAYER, moves(emote_x))
    delay(60)
    suitcall("{FONT_SMALL}That's a joke.\h30 But please be careful.{FONT_NORMAL}
              If Pok\eballs don't work on aliens, uh.\h30.\h30.\h15
              Well,\h30 they'll work. Good luck!")
            //Odd how this planet's so like ours, isn't it
    waitmessage
    // No hang-up sound because he's still listening
    setvar(VAR_0x8004, 1) // Study Mode limit
    special(EnterStudyMode)
    setflag(FLAG_SYS_B_DASH)
    setflag(FLAG_SYS_PC_LANETTE)
    setflag(FLAG_HIDE_FIRST_PALOOKA)
    setflag(FLAG_HIDE_SECOND_PALOOKA)
    releaseall
    end
}

script Banzo_EventScript_AfterCatch {
    lockall
    playse(SE_POKENAV_ON)
    suitcall(format("Prof. Banzo: Phew. So they do work.\p"
             "I'm going to analyze the data. I'm here if you need to talk to me!\p"
             "Remember: you're there to figure out why the native life has started getting aggressive with each other...and what those odd devices we've observed are.\p"
             "Rest up in the lander when you need to, and use the synthesizer too.\p"
             "Good luck, and be safe."))
    waitmessage
    call(Tamagotchi_SuitCallEnd)
    waitse
    msgbox(format("Open your I.D. card in the start menu for a reminder of what to do, or call Banzo for a more elaborate explanation."))
    setflag(FLAG_SYS_SCALE_OPPONENTS)
    clearflag(FLAG_HIDE_FIRST_PALOOKA)
    clearflag(FLAG_HIDE_SECOND_PALOOKA)
    additem(ITEM_POKE_BALL,20)
    releaseall
    end
}

script Capsule {
    lock
    //call Common_EventScript_OutOfCenterPartyHeal
    special(ScriptMenu_CreateCapsuleMultichoice)
    // - Rest
    // - Items
    // - PC
    // - Call
    // - Exit
    switch (var(VAR_RESULT)) {
        case 0:
            call(Common_EventScript_OutOfCenterPartyHeal)
            msgbox("You feel refreshed!")
        case 1:
            msgbox("You fire up the synthesizer.")
        case 2:
            call(EventScript_AccessPokemonBoxLink)
        case 3:
            msgbox("No answer.")
        case MULTI_B_PRESSED:
            break
    }
    release
    end
}

script LandingSite_CatchIntro_PushLeft {
    msgbox(format("It's too dangerous to go on alone."))
    applymovement(LOCALID_PLAYER, moves(walk_left))
    waitmovement
    release
    end
}

script LandingSite_CatchIntro_PushUp {
    msgbox(format("It's too dangerous to go on alone."))
    applymovement(LOCALID_PLAYER, moves(walk_up))
    waitmovement
    release
    end
}

script Tamagotchi_SuitCallBegin
{
    playse(SE_POKENAV_CALL)
    waitse
    playse(SE_POKENAV_ON)
    return
}

script Tamagotchi_SuitCallEnd
{
    playse(SE_POKENAV_HANG_UP)
    return
}

script Tamagotchi_Palookaport_Out {
    applymovement(VAR_LAST_TALKED, Common_Movement_WalkInPlaceDown)
    waitmovement
    setvar(VAR_0x8006, 65535)
    setfieldeffectargument(0, VAR_0x8006)
    setfieldeffectargument(1, VAR_LAST_TALKED)
    setfieldeffectargument(2, 124) #subpriority
    setfieldeffectargument(3, 2) #priority
    setfieldeffectargument(4, 0) #teleport anim (0 = out, 1 = in)
    dofieldeffect(FLDEFF_PALOOKAPORT)
    delay(24) //Delay to correct frame before disappearing
    removeobject(VAR_LAST_TALKED)
    waitfieldeffect(FLDEFF_PALOOKAPORT)
}

script Tamagotchi_Palookaport_In {
    addobject(VAR_LAST_TALKED) // This will need modified to handle arbitrary IDs
    hideobjectat(VAR_LAST_TALKED, MAP_BEACH)
    setfieldeffectargument(0, VAR_0x8006)
    setfieldeffectargument(1, VAR_LAST_TALKED)
    setfieldeffectargument(2, 124) #subpriority
    setfieldeffectargument(3, 2) #priority
    setfieldeffectargument(4, 1) #teleport anim (0 = out, 1 = in)
    dofieldeffect(FLDEFF_PALOOKAPORT)
    delay(24) //Delay to correct frame before appearing anyone
    showobjectat(VAR_LAST_TALKED, MAP_BEACH)
    waitfieldeffect(FLDEFF_PALOOKAPORT)
}

script Tamagotchi_BabyEvo_Explanation {
    if (!flag(FLAG_EVOLVED_MON)) {
        // Eject because no mon has been evolved
        end
    }
    bufferspeciesname(STR_VAR_1, VAR_LAST_EVO)
    switch (var(VAR_LAST_EVO)) {
        case SPECIES_LAND_KID:
            bufferstring(STR_VAR_2, "Land Hills")
        case SPECIES_WATER_KID:
            bufferstring(STR_VAR_2, "Water Beach")
        case SPECIES_SKY_KID:
            bufferstring(STR_VAR_2, "Sky Mountain")
        default:
            clearflag(FLAG_EVOLVED_MON)
            end //Eject because wrong evo
    }
    lock
    call(Tamagotchi_SuitCallBegin)
    suitcall(format("Prof. Banzo: {PLAYER}! The Exo-Pokémon of this planet evolve like ours back home, but somewhat differently.\p"
    "A \qobaby\qc evolves depending on the area of the island it spends time in.\p"
    "That little {STR_VAR_1} evolved in {STR_VAR_2}...makes sense, right?"))
    waitmessage
    call(Tamagotchi_SuitCallEnd)
    addvar(VAR_TAMAGOTCHI_STAGE_EXPLAINED, 1)
    clearflag(FLAG_EVOLVED_MON)
    release
}

script Tamagotchi_KidEvo_Explanation {
    lock
    call(Tamagotchi_SuitCallBegin)
    suitcall(format("Prof. Banzo: {PLAYER}! The \qokids\qc of this world evolve based on their diet.\p"
    "They'll evolve into different \qoyoung\qc depending on the food you give them.\p"
    "The synthesizer should be able to fabricate suitable nourishment."))
    waitmessage
    call(Tamagotchi_SuitCallEnd)
    addvar(VAR_TAMAGOTCHI_STAGE_EXPLAINED, 1)
    release
}

script Tamagotchi_YoungEvo_Explanation {
    lock
    call(Tamagotchi_SuitCallBegin)
    suitcall(format("Prof. Banzo: {PLAYER}! The \qoyoung\qc of this world evolve from scents.\p"
    "Like diet, scents take some time to trigger their evolution.\p"
    "The correct pheromones can be synthesized with enough charge."))
    waitmessage
    call(Tamagotchi_SuitCallEnd)
    addvar(VAR_TAMAGOTCHI_STAGE_EXPLAINED, 1)
    release
}

script Tamagotchi_FirstPalooka {
    trainerbattle_single(TRAINER_FIRST_PALOOKA, Tamagotchi_FirstPalooka_Intro, Tamagotchi_FirstPalooka_Defeat, Tamagotchi_FirstPalooka_Defeated)
}

text Tamagotchi_FirstPalooka_Intro {
    //"{FONT_PALOOKA}IDENTIFY YOURSELF!"
    //"Whoa! who are you?" > "Whoa! you are-Q?"
    "{FONT_PALOOKA}KA! KE TO,WA?"
}

text Tamagotchi_FirstPalooka_Defeat {
    //"Did you come from that capsule?" > "From capsule you come-Q?"
    "{FONT_PALOOKA}JO LADA KE APGE,WA?"
}

script Tamagotchi_FirstPalooka_Defeated {
    lock
    special(PlayerFaceTrainerAfterBattle)
	waitmovement
    msgbox(format("Translator calibrated.\p"
    "Identify yourself!"))
    waitmessage
    msgbox(format("I gotta tell Jomo about this!"))
    waitmessage
    closemessage
    addvar(VAR_PALOOKAS_DEFEATED, 1)
    call(Tamagotchi_Palookaport_Out)
    release
}

script Tamagotchi_SecondPalooka {
    trainerbattle_single(TRAINER_SECOND_PALOOKA, Tamagotchi_SecondPalooka_Intro, Tamagotchi_SecondPalooka_Defeat, Tamagotchi_SecondPalooka_Defeated)
}

text Tamagotchi_SecondPalooka_Intro {
    "{FONT_PALOOKA}KE TO,WA? {FONT_NORMAL}Oh, you're the alien!\p"
    "My orders are to stop you from\ninterfering!"
}

text Tamagotchi_SecondPalooka_Defeat {
    format("Jomo will be hearing about this...!")
}

script Tamagotchi_SecondPalooka_Defeated {
    lock
    special(PlayerFaceTrainerAfterBattle)
	waitmovement
    msgbox(format("These monsters are ours, alien. We've worked hard to make them battle-ready.\p"
    "You'd better go home before Jomo decides to take care of you himself."))
    closemessage
    addvar(VAR_PALOOKAS_DEFEATED, 1)
    call(Tamagotchi_Palookaport_Out)
    delay(30)
    call(Tamagotchi_SuitCallBegin)
    suitcall(format("???: Ahahaha! Alien! You hear now the voice of Jomo, leader of this operation!\p"
    "Before we arrived, these monsters were miserably joyful. You're here to stop us from making lucrative fighters of them.\p"
    "I respect this, though you will fail.\n"
    "No one can defeat a Palooka whose eyes are set on victory.\p"
    "We'll be in touch, alien."))
    waitmessage
    call(Tamagotchi_SuitCallEnd)
    waitse
    call(Tamagotchi_SuitCallBegin)
    suitcall(format("Prof. Banzo: Jomo seems scary... I'll try to pinpoint his location from up here. Keep doing what you're doing!"))
    waitmessage
    call(Tamagotchi_SuitCallEnd)
    release
}